<p style="color: green"><%= notice %></p>

<% content_for :title, "Bars" %>

<!--<h1>Bars</h1>-->

<div id="bars" style="width:100%">
  <% @bars.each do |bar| %>
    <div class="bg-white rounded-lg px-6 py-8 ring shadow-xl ring-gray-900/5 m-4">
      <%= render bar %>
      <% if authenticated? %>
        <br>
        <%= link_to "Edit", edit_bar_path(bar), class: 'bg-amber-500 rounded-lg p-2 shadow-xl' %>
      <% end %>
    </div>
  <% end %>
</div>

<% if authenticated? %>
  <%= link_to "New bar", new_bar_path, class: 'bg-green-500 rounded-lg p-2 shadow-xl m-4' %>
<% end %>
